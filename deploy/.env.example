LICENSE_DOMAIN=license.example.com
ACME_EMAIL=ops@example.com
LICENSEHUB_VERSION=dev
LICENSEHUB_COMMIT=unknown
LICENSEHUB_BUILD_DATE=unknown

# Immutable registry lock set; deploy/images.lock is authoritative.
BUN_IMAGE=oven/bun:1@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6
GOLANG_IMAGE=golang:1.25-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59
ALPINE_IMAGE=alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d
POSTGRES_IMAGE=postgres:18-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2
REDIS_IMAGE=redis:8-alpine@sha256:becdda6c7f4b3fb42e42fd7f120bbf5c54c4caaaf16f26da24e4563d2c1f0576
CADDY_IMAGE=caddy:2.10-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d

POSTGRES_USER=licensehub
POSTGRES_DB=licensehub
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgres://licensehub:CHANGE_ME_RANDOM_DATABASE_PASSWORD@postgres:5432/licensehub?sslmode=disable

JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
LICENSE_SIGNING_KEY=CHANGE_ME_64_HEX_CHAR_ED25519_SEED
LICENSE_SIGNING_KEY_ID=v1
LICENSE_LEASE_TTL=72h
LICENSE_RETAINED_PUBLIC_KEYS={}
RELEASE_KEY_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHAR_MASTER_KEY
METRICS_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAILS=admin@example.com

RATE_LIMIT_API=60
RATE_LIMIT_ADMIN=120
RATE_LIMIT_AUTH=20
BF_MAX_FAILS=5
BF_LOCKOUT_SECONDS=30

# SMTP is mandatory for production OTP delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=LicenseHub <license@example.com>

# Encrypted recovery/off-host operations. The age recipient is public; keep
# the matching identity only on the recovery host.
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_RECOVERY_PUBLIC_RECIPIENT
BACKUP_RETENTION_DAYS=30
BACKUP_OFFSITE_HOOK=
ALERT_HOOK=
LOG_OFFSITE_HOOK=
ALERT_WEBHOOK_URL=
