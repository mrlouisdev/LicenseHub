	email {$ACME_EMAIL}
	admin off
}

{$LICENSE_DOMAIN} {
	encode zstd gzip
	reverse_proxy server:9000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format json
	}
}

